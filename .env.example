# ──────────────────────────────────────────────────────────────────
# Copiar este archivo como .env y completar los valores
# NUNCA commitear el .env real
# ──────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://e2e_user:e2e_pass@localhost:5432/e2e_platform

# Redis
REDIS_URL=redis://localhost:6379

# JWT — mínimo 32 caracteres aleatorios
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARS_HERE
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Vault — clave AES-256: exactamente 64 caracteres hex (32 bytes)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_HERE_00000000000000000000000000000000

# DeepSeek API
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Docker
DOCKER_NETWORK=e2e-net
RECORDER_IMAGE=e2e-platform/recorder:latest
EXECUTION_IMAGE=e2e-platform/executor:latest
ARTIFACTS_VOLUME_PATH=/artifacts
