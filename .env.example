# ──────────────────────────────────────────────────────────────────
# Copiar este archivo como .env y completar los valores
# NUNCA commitear el .env real
# ──────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# PostgreSQL
# OJO si ya tienes PostgreSQL instalado en tu maquina: el servicio nativo se queda con el
# puerto 5432 y `localhost:5432` responde desde ESA base, no desde el contenedor. El error
# que sale es "Authentication failed" y despista, porque las credenciales estan bien.
# Solucion: cambia POSTGRES_PORT y el puerto de DATABASE_URL a otro libre (5433, por ejemplo).
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://e2e_user:e2e_pass@localhost:5432/e2e_platform

# Redis
REDIS_URL=redis://localhost:6379

# URLs vistas DESDE EL CONTENEDOR del executor (red Docker), no desde el host.
# Necesarias en dev (backend/worker por `npm`, infra en Docker): el executor corre
# como contenedor y `localhost` apuntaría a sí mismo. Apunta a los contenedores de
# infra por nombre en la red DOCKER_NETWORK. Si se omiten, se usa DATABASE_URL/REDIS_URL.
CONTAINER_DATABASE_URL=postgresql://e2e_user:e2e_pass@e2e_postgres:5432/e2e_platform
CONTAINER_REDIS_URL=redis://e2e_redis:6379

# JWT — mínimo 32 caracteres aleatorios
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARS_HERE
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Vault — clave AES-256: exactamente 64 caracteres hex (32 bytes)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_HERE_00000000000000000000000000000000

# DeepSeek API (IA de texto)
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini (IA multimodal/visión) — OPCIONAL. Si se deja vacío, el self-healing recae
# en DeepSeek (texto) e ignora el screenshot del fallo.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash

# Self-healing automático
AUTO_HEALING_ENABLED=true            # dispara propuestas de fix al fallar un step
SELF_HEALING_MIN_CONFIDENCE=0.5      # umbral [0-1] para auto-crear la propuesta

# Git sync — override solo para GitHub Enterprise / GitLab self-hosted
GITHUB_API_URL=https://api.github.com
GITLAB_API_URL=https://gitlab.com/api/v4

# Docker
DOCKER_NETWORK=e2e-net
RECORDER_IMAGE=e2e-platform/recorder:latest
EXECUTION_IMAGE=e2e-platform/executor:latest
ARTIFACTS_VOLUME_PATH=/artifacts
ARTIFACTS_RETENTION_DAYS=14          # limpieza de artefactos antiguos (0 = no limpiar)
